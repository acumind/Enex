# =============================================================================
# Enex Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# Next.js env var rules:
#   NEXT_PUBLIC_* → exposed to the browser (safe for non-sensitive values only)
#   All others    → server-side only (never sent to the browser)
#
# In staging/production, these are set as Azure Container Apps environment
# variables (non-sensitive) or injected via Azure Key Vault (sensitive).
# =============================================================================


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Backend API base URL (used by both server components and client components).
# Dev:     http://localhost:8000/api/v1
# Staging: https://api.staging.enex.in/api/v1
# Prod:    https://api.enex.in/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Current environment — controls feature flags, logging verbosity, etc.
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# The canonical public URL of this frontend deployment.
# Used for OG image absolute URLs, sitemap generation, and NextAuth callbacks.
# Dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Auth — NextAuth.js v5
# -----------------------------------------------------------------------------

# Secret used by NextAuth.js to sign session tokens and CSRF tokens.
# Must match JWT_SECRET in the backend .env only if NextAuth sessions embed
# backend JWTs directly. Otherwise can be an independent random string.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-use-a-long-random-string-in-production

# The canonical URL of this Next.js deployment.
# NextAuth uses this to construct OAuth callback URLs.
# Dev:     http://localhost:3000
# Staging: https://staging.enex.in
# Prod:    https://enex.in
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Auth — Google OAuth
# -----------------------------------------------------------------------------

# Must match the values configured in Google Cloud Console.
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Monitoring — Sentry
# -----------------------------------------------------------------------------

# Public DSN — safe to expose to the browser for client-side error reporting.
# Leave blank to disable Sentry (acceptable for local dev).
NEXT_PUBLIC_SENTRY_DSN=

# Auth token for uploading source maps to Sentry during build.
# Obtain from: https://sentry.io/settings/account/api/auth-tokens/
# Server-side only — never prefixed with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# Sentry organisation and project slugs (used by the Sentry Next.js plugin).
SENTRY_ORG=
SENTRY_PROJECT=enex-frontend
