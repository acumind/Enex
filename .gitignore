# =============================================================================
# Enex — .gitignore
# =============================================================================

# ----- Environment files (NEVER commit real secrets) -----
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ----- Node / Next.js -----
node_modules/
.next/
out/
frontend/.next/
frontend/out/
frontend/node_modules/

# ----- Generated files -----
frontend/lib/generated/

# ----- OS -----
.DS_Store
Thumbs.db

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo

# ----- Docker -----
*.log

# ----- Sentry -----
.sentryclirc
