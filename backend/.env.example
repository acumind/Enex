# =============================================================================
# Enex Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# In staging/production, all values are stored in Azure Key Vault and
# injected into the container by Azure Container Apps via managed identity.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Environment: development | staging | production
ENVIRONMENT=development

# Application version (used in health check response and Sentry release tracking)
APP_VERSION=0.1.0

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG


# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------

# Local dev:      postgresql+asyncpg://enex:dev_password@localhost:5432/enex
# Azure staging:  postgresql+asyncpg://<user>:<pass>@<host>.postgres.database.azure.com:5432/enex?ssl=require
# Azure prod:     postgresql+asyncpg://<user>:<pass>@<host>.postgres.database.azure.com:5432/enex?ssl=require
DATABASE_URL=postgresql+asyncpg://enex:dev_password@localhost:5432/enex

# Maximum DB connections in the pool (default: 10)
DB_POOL_SIZE=10

# Connections allowed beyond pool size during traffic spikes (default: 5)
DB_MAX_OVERFLOW=5


# -----------------------------------------------------------------------------
# Redis — Cache, Job Queue, Rate Limiting, OTP Store
# -----------------------------------------------------------------------------

# Local dev:    redis://localhost:6379/0
# Azure:        rediss://<host>:6380/0   ← note: rediss:// (double-s) for TLS on Azure
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Security — JWT
# -----------------------------------------------------------------------------

# Secret key for signing JWT tokens (HS256).
# Dev: any random string. Prod: minimum 64 random characters.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-me-use-a-long-random-string-in-production

# JWT signing algorithm.
# Dev default: HS256 (shared secret — simple to set up).
# Production option: RS256 (asymmetric key pair — set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY instead).
JWT_ALGORITHM=HS256

# For RS256 only (leave blank when using HS256):
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Access token expiry in hours.
# Dev default: 24 hours (mobile-friendly, avoids frequent re-auth during testing).
# Production recommendation: 1–4 hours.
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Refresh token expiry in days.
# Dev default: 30 days.
# Production recommendation: 7–14 days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Dev: http://localhost:3000
# Staging/Prod: your actual frontend URL
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# OTP Configuration
# -----------------------------------------------------------------------------

# OTP code length (digits)
OTP_LENGTH=6

# OTP validity window in minutes
OTP_EXPIRE_MINUTES=5

# Maximum verification attempts before the OTP is invalidated
OTP_MAX_ATTEMPTS=3

# Maximum OTP send requests per identifier per hour (anti-bombing)
OTP_RATE_LIMIT_PER_HOUR=5

# Minimum seconds between OTP send requests to the same identifier
OTP_COOLDOWN_SECONDS=60


# -----------------------------------------------------------------------------
# Auth — Google OAuth
# -----------------------------------------------------------------------------

# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Auth — MSG91 (Mobile OTP via SMS)
# -----------------------------------------------------------------------------

# Obtain from: https://msg91.com/
# DLT registration required for Indian phone numbers.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ENEXIN
MSG91_TEMPLATE_ID=


# -----------------------------------------------------------------------------
# Email — Resend (Email OTP + Notifications)
# -----------------------------------------------------------------------------

# Obtain from: https://resend.com/
RESEND_API_KEY=re_

# The "from" address used in all outgoing emails.
# Must be a verified domain in your Resend account.
RESEND_FROM_EMAIL=noreply@enex.in


# -----------------------------------------------------------------------------
# AI — Anthropic Claude (Prediction Extraction)
# -----------------------------------------------------------------------------

# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# Claude model to use for extraction.
# Default: claude-sonnet-4-6 (fast + cost-effective for extraction tasks)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Maximum tokens sent to Claude per extraction request (cost + injection protection)
ANTHROPIC_MAX_INPUT_TOKENS=8000


# -----------------------------------------------------------------------------
# Price Data
# -----------------------------------------------------------------------------

# Default evaluation timeframe when a prediction has no explicit target_date.
# A prediction made without a target date is evaluated after this many months.
DEFAULT_EVAL_MONTHS=12

# Tolerance band for partial hits: within this % of target = partial hit (not a miss).
OUTCOME_TOLERANCE_PCT=5.0


# -----------------------------------------------------------------------------
# Source Archival — Wayback Machine
# -----------------------------------------------------------------------------

# Set to false to disable archival during local development (avoids hitting the API).
WAYBACK_ARCHIVAL_ENABLED=false

# Maximum seconds to wait for Wayback Machine API response before timing out.
WAYBACK_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# Monitoring — Sentry
# -----------------------------------------------------------------------------

# Obtain from: https://sentry.io/
# Leave blank to disable Sentry (acceptable for local dev).
SENTRY_DSN=

# Percentage of transactions to trace for performance monitoring (0.0–1.0).
# Use 1.0 (100%) in dev, 0.1 (10%) in production.
SENTRY_TRACES_SAMPLE_RATE=1.0


# -----------------------------------------------------------------------------
# Admin Seeding
# -----------------------------------------------------------------------------

# Used only by the create-admin CLI command (python -m app.cli create-admin).
# Not used at runtime.
# SEED_ADMIN_EMAIL=admin@enex.in
# SEED_ADMIN_NAME=Enex Admin
